# ==============================================================================
# Site Sentry Backend Environment Configuration
# ==============================================================================
# Copy this file to .env in services/api/ or set these in your deployment environment.
# Never commit actual production secrets to source control.

# Application Environment ('development' or 'production')
# When set to 'production', SECRET_KEY must be a strong secret of >= 32 characters.
API_ENV=development

# Server Binding
API_HOST=127.0.0.1
API_PORT=8000

# Database Connection (Async Driver Required)
# Development SQLite default: sqlite+aiosqlite:///./sitesentry.db
# Production PostgreSQL example: postgresql+asyncpg://sentry:sentry_password@postgres:5432/sitesentry
DATABASE_URL=sqlite+aiosqlite:///./sitesentry.db

# Redis Cache Connection & TTL
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Application Cryptographic Secret
# Used for HMAC-SHA-256 URL analysis cache key derivation and security tokens.
# REQUIRED in production (minimum 32 characters). Do NOT use default in production.
SECRET_KEY=change_this_to_a_secure_random_32_character_secret_in_production

# CORS Allowed Origins
# Comma-separated list of origins permitted to access the API.
# In production, restrict to your dashboard domain and Chrome Extension ID:
# CORS_ORIGINS=https://dashboard.sitesentry.io,chrome-extension://YOUR_EXTENSION_ID
CORS_ORIGINS=*

# Threat Intelligence Providers (Optional)
# If omitted or None, threat intelligence providers report UNAVAILABLE and are skipped gracefully.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=2.5
