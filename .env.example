# ==============================================================================
# Site Sentry Platform Environment Configuration (Monorepo Root / Docker Compose)
# ==============================================================================
# Use this template for local docker-compose deployments.
# Never commit real API keys or production secrets to source control.

# Application Environment ('development' or 'production')
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_USER=sentry
POSTGRES_PASSWORD=sentry_password
POSTGRES_DB=sitesentry
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Cryptographic Secret (REQUIRED >= 32 characters in production)
SECRET_KEY=change_this_to_a_secure_random_32_character_secret_in_production

# CORS Allowed Origins (Comma-separated list or '*' for local development)
CORS_ORIGINS=*

# Threat Intelligence Providers (Optional)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=2.5

# Dashboard Public API Target
NEXT_PUBLIC_API_URL=http://localhost:8000

# Extension Build API Target
VITE_API_BASE_URL=http://localhost:8000
